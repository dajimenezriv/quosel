{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quosel-sites",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-13",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "quosel",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "DOMAINS",
      "id": "788820ad7a3d4664a1441e237c2dd784",
    },
  ],
}
