---
import Layout from '../layouts/Layout.astro';

const appUrl = 'https://app.quosel.com';

const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'How it works', href: '#how' },
  { label: 'Testimonials', href: '#testimonials' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'Blog', href: '#blog' },
];

const tabs = [
  { label: 'URL Import', icon: '↗' },
  { label: 'Business Info', icon: '🏢' },
  { label: 'Auto Layout', icon: '⊞' },
  { label: 'Review Import', icon: '★' },
  { label: 'Mobile Ready', icon: '📱' },
  { label: 'White Label', icon: '🏷' },
];
---

<Layout>
  <!-- Navbar -->
  <header class="sticky top-0 z-50 border-b border-stone-200/60 bg-[#faf7f2]/80 backdrop-blur-sm">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#c44a2b] text-sm font-bold text-white">
          Q
        </div>
        <span class="text-base font-semibold tracking-tight text-stone-900">Quosel</span>
      </a>

      <!-- Nav links -->
      <div class="hidden items-center gap-7 text-sm text-stone-600 md:flex">
        {navLinks.map(({ label, href }) => (
          <a href={href} class="hover:text-stone-900 transition-colors">{label}</a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <button
          aria-label="Toggle dark mode"
          class="flex h-9 w-9 items-center justify-center rounded-lg border border-stone-300 bg-white text-stone-600 hover:bg-stone-50 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <a
          href={appUrl}
          class="rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-800 hover:bg-stone-50 transition-colors"
        >
          Sign up
        </a>
      </div>
    </nav>
  </header>

  <main class="bg-[#faf7f2]">
    <!-- Hero -->
    <section class="mx-auto max-w-4xl px-6 pb-0 pt-20 text-center">
      <!-- Badge -->
      <div class="mb-8 inline-flex items-center gap-2 rounded-full bg-stone-200/70 px-4 py-1.5 text-sm">
        <span class="flex items-center gap-1 rounded-full bg-[#c44a2b] px-2 py-0.5 text-xs font-semibold text-white">
          🔥 New
        </span>
        <span class="text-stone-600">Introducing AI-powered pages</span>
      </div>

      <!-- Heading -->
      <h1 class="mx-auto max-w-3xl text-5xl font-bold leading-tight tracking-tight text-stone-900 sm:text-6xl">
        Turn any Google Maps link into a ready-to-ship landing page.
      </h1>

      <!-- Subtext -->
      <p class="mx-auto mt-6 max-w-2xl text-base text-stone-500 sm:text-lg">
        Paste a URL, get a polished site with photos, reviews, and contact info — auto-imported and ready to deliver the same day.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={appUrl}
          class="inline-flex items-center gap-2 rounded-lg bg-[#c44a2b] px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#b03d23] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
          Get Started
        </a>
        <a
          href="#pricing"
          class="inline-flex items-center gap-2 rounded-lg border border-stone-300 bg-white px-6 py-3 text-base font-semibold text-stone-700 shadow-sm hover:bg-stone-50 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
          View Pricing
        </a>
      </div>

      <!-- Social proof -->
      <div class="mt-10 flex flex-col items-center justify-center gap-6 sm:flex-row sm:gap-8">
        <!-- Users -->
        <div class="flex items-center gap-3">
          <div class="flex -space-x-2">
            {['#c44a2b','#2b7ac4','#2bc47a','#c4b12b'].map((color, i) => (
              <div
                class="h-8 w-8 rounded-full border-2 border-[#faf7f2] flex items-center justify-center text-xs font-bold text-white"
                style={`background-color: ${color}; z-index: ${4 - i}`}
              >
                {String.fromCharCode(65 + i)}
              </div>
            ))}
          </div>
          <span class="text-sm font-medium text-stone-700">12K+ Users</span>
        </div>

        <div class="hidden h-4 w-px bg-stone-300 sm:block"></div>

        <!-- Ratings -->
        <div class="flex items-center gap-2">
          <div class="flex text-[#f59e0b]">
            {'★★★★'.split('').map(() => <span>★</span>)}
            <span class="text-stone-300">★</span>
          </div>
          <span class="text-sm font-medium text-stone-700">4.5 Ratings</span>
        </div>
      </div>
    </section>

    <!-- Feature tabs -->
    <div class="mt-16 border-t border-stone-200/80">
      <div class="mx-auto max-w-6xl overflow-x-auto">
        <div class="flex min-w-max divide-x divide-stone-200/80">
          {tabs.map(({ label, icon }, i) => (
            <button
              class={[
                'flex items-center gap-2 px-8 py-5 text-sm font-medium transition-colors whitespace-nowrap',
                i === 0
                  ? 'border-b-2 border-[#c44a2b] bg-white text-stone-900'
                  : 'bg-[#faf7f2] text-stone-500 hover:bg-white hover:text-stone-800'
              ].join(' ')}
            >
              <span>{icon}</span>
              {label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Workflow diagram (tab 1 content) -->
    <div class="overflow-x-auto border-b border-stone-200/80">
      <div class="relative bg-[#faf7f2]" style="min-width: 1100px; height: 460px;">

        <!-- Dot grid -->
        <div
          class="absolute inset-0"
          style="background-image: radial-gradient(circle, #c8bfb4 1.2px, transparent 1.2px); background-size: 28px 28px;"
        ></div>

        <!-- SVG arrows -->
        <svg
          class="absolute inset-0 pointer-events-none"
          width="1100" height="460"
          viewBox="0 0 1100 460"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <marker id="arr" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto">
              <path d="M0,1 L0,6 L5,3.5 z" fill="#b8b0a4" />
            </marker>
          </defs>
          <!-- Input → Action -->
          <path d="M 290,155 C 360,155 420,225 420,248" stroke="#c0b8ae" stroke-width="1.5" fill="none" marker-end="url(#arr)" />
          <!-- Action → Output -->
          <path d="M 700,255 C 760,255 810,205 810,160" stroke="#c0b8ae" stroke-width="1.5" fill="none" marker-end="url(#arr)" />
        </svg>

        <!-- Input card -->
        <div class="absolute rounded-xl border border-stone-200 bg-white shadow-sm overflow-hidden" style="left:30px;top:30px;width:260px;">
          <div class="px-3 pt-3">
            <span class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              Input
            </span>
          </div>
          <div class="flex items-start justify-between px-3 pt-2 pb-1">
            <div>
              <div class="flex items-center gap-1.5 text-sm font-semibold text-stone-800">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-400"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Google Maps URL
              </div>
              <p class="mt-0.5 text-xs leading-relaxed text-stone-400">Paste any business link to auto-import all data.</p>
            </div>
            <span class="text-stone-300 text-base leading-none mt-0.5">⋮</span>
          </div>
          <div class="border-t border-stone-100 bg-stone-50/70 px-3 py-3">
            <p class="mb-2 text-xs font-medium text-amber-500">Fetching data...</p>
            <div class="mb-3 h-1.5 w-full overflow-hidden rounded-full bg-stone-200">
              <div class="h-full rounded-full bg-amber-400" style="width:62%;"></div>
            </div>
            <div class="space-y-1.5">
              <div class="flex items-center gap-2 text-xs text-stone-600">
                <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-green-100 text-[9px] font-bold text-green-600">G</span>
                Business details
              </div>
              <div class="flex items-center gap-2 text-xs text-stone-600">
                <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-amber-100 text-[9px] text-amber-500">★</span>
                Reviews &amp; ratings
              </div>
              <div class="flex items-center gap-2 text-xs text-stone-600">
                <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-blue-100 text-[9px] text-blue-500">▣</span>
                Place photos
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1 border-t border-stone-100 px-3 py-2 text-xs text-stone-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            0.0 sec
          </div>
        </div>

        <!-- Action card -->
        <div class="absolute rounded-xl border border-stone-200 bg-white shadow-sm overflow-hidden" style="left:420px;top:185px;width:280px;">
          <div class="px-3 pt-3">
            <span class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
              Action
            </span>
          </div>
          <div class="flex items-start justify-between px-3 pt-2 pb-5">
            <div>
              <div class="flex items-center gap-1.5 text-sm font-semibold text-stone-800">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-400"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/><polyline points="19 5 12 12 5 5"/></svg>
                Page Generation
              </div>
              <p class="mt-0.5 text-xs leading-relaxed text-stone-400">AI builds a complete, mobile-ready page from the imported business data.</p>
            </div>
            <span class="text-stone-300 text-base leading-none mt-0.5">⋮</span>
          </div>
          <div class="flex items-center justify-between border-t border-stone-100 px-3 py-2">
            <span class="flex items-center gap-1 text-xs text-stone-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              1.2 sec
            </span>
            <span class="inline-flex items-center gap-1 rounded-full border border-[#c44a2b]/50 px-2.5 py-0.5 text-xs font-medium text-[#c44a2b]">
              <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
              Quosel AI
            </span>
          </div>
        </div>

        <!-- Output card -->
        <div class="absolute rounded-xl border border-stone-200 bg-white shadow-sm overflow-hidden" style="left:810px;top:30px;width:260px;">
          <div class="px-3 pt-3">
            <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Output
            </span>
          </div>
          <div class="flex items-start justify-between px-3 pt-2 pb-1">
            <div>
              <div class="flex items-center gap-1.5 text-sm font-semibold text-stone-800">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-400"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Landing Page
              </div>
              <p class="mt-0.5 text-xs leading-relaxed text-stone-400">Your polished page is ready to review and deliver.</p>
            </div>
            <span class="text-stone-300 text-base leading-none mt-0.5">⋮</span>
          </div>
          <div class="border-t border-stone-100 bg-stone-50/70 px-3 py-3">
            <p class="mb-1.5 text-xs font-semibold text-stone-500">Preview</p>
            <p class="text-xs leading-relaxed text-stone-400">Business photos, reviews, hours, map, and contact form are all beautifully laid out.</p>
            <div class="mt-3 flex items-center gap-2 text-xs text-stone-600">
              <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-stone-200 text-[9px] text-stone-500">▤</span>
              page.html exported
            </div>
          </div>
          <div class="flex items-center gap-1 border-t border-stone-100 px-3 py-2 text-xs text-stone-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            0.0 sec
          </div>
        </div>

      </div>
    </div>

    <!-- Use Cases -->
    <section id="use-cases" class="bg-[#faf7f2]">

      <!-- Label -->
      <div class="py-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Use Cases</p>
        <p class="mt-1 text-sm text-stone-400">Practical ways Quosel delivers value to your business.</p>
      </div>

      <!-- Bordered content box -->
      <div class="mx-auto max-w-5xl">
        <div class="border-x border-t border-stone-200">

          <!-- Split -->
          <div class="grid grid-cols-1 sm:grid-cols-2">

            <!-- LEFT: tab panels -->
            <div class="border-b border-stone-200 sm:border-b-0 sm:border-r">

              <div id="uc-freelancer" class="uc-panel p-10 sm:p-12">
                <h2 class="text-3xl font-bold leading-tight tracking-tight text-stone-900 sm:text-4xl">
                  See how we help <span class="text-stone-400">freelancers</span> land clients, <span class="text-stone-400">every</span> week.
                </h2>
                <p class="mt-6 text-sm leading-relaxed text-stone-500">
                  Quosel turns any Google Maps link into a pitch-ready landing page. Show prospects exactly what their site could look like — before writing a single line of code. Close deals faster with real deliverables.
                </p>
                <a href={appUrl} class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-[#c44a2b] hover:underline">
                  Learn more
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                </a>
              </div>

              <div id="uc-agency" class="uc-panel hidden p-10 sm:p-12">
                <h2 class="text-3xl font-bold leading-tight tracking-tight text-stone-900 sm:text-4xl">
                  See how <span class="text-stone-400">agencies</span> deliver sites for <span class="text-stone-400">every</span> client, faster.
                </h2>
                <p class="mt-6 text-sm leading-relaxed text-stone-500">
                  Agencies use Quosel to cut production time from days to hours. Auto-import client data, apply your template, and ship — without the back-and-forth on assets and manual data gathering.
                </p>
                <a href={appUrl} class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-[#c44a2b] hover:underline">
                  Learn more
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                </a>
              </div>

              <div id="uc-studio" class="uc-panel hidden p-10 sm:p-12">
                <h2 class="text-3xl font-bold leading-tight tracking-tight text-stone-900 sm:text-4xl">
                  See how studios <span class="text-stone-400">scale</span> output without adding <span class="text-stone-400">headcount</span>.
                </h2>
                <p class="mt-6 text-sm leading-relaxed text-stone-500">
                  Web studios use Quosel to handle the heavy lifting — import, layout, mobile optimization — so their team stays focused on craft and the work that actually needs their expertise.
                </p>
                <a href={appUrl} class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-[#c44a2b] hover:underline">
                  Learn more
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                </a>
              </div>

            </div>

            <!-- RIGHT: visual + quote -->
            <div class="relative min-h-80 overflow-hidden bg-linear-to-br from-stone-300 via-stone-200 to-amber-100">
              <!-- Decorative circles -->
              <div class="absolute -right-12 -top-12 h-56 w-56 rounded-full bg-white/20"></div>
              <div class="absolute -bottom-20 -left-20 h-72 w-72 rounded-full bg-white/15"></div>
              <div class="absolute right-1/3 top-1/3 h-28 w-28 rounded-full bg-white/10"></div>

              <!-- Floating quote cards -->
              <div id="quote-freelancer" class="uc-quote absolute bottom-6 right-6 max-w-65 rounded-xl bg-white p-5 shadow-lg">
                <p class="text-sm leading-relaxed text-stone-700">"I show a real page during the first call. My close rate doubled in the first month."</p>
                <p class="mt-3 text-xs text-stone-400">— Lucas M., Freelance web designer</p>
              </div>
              <div id="quote-agency" class="uc-quote hidden absolute bottom-6 right-6 max-w-65 rounded-xl bg-white p-5 shadow-lg">
                <p class="text-sm leading-relaxed text-stone-700">"We went from 5-day turnarounds to same-day delivery. Clients absolutely love it."</p>
                <p class="mt-3 text-xs text-stone-400">— Sarah K., Agency owner</p>
              </div>
              <div id="quote-studio" class="uc-quote hidden absolute bottom-6 right-6 max-w-65 rounded-xl bg-white p-5 shadow-lg">
                <p class="text-sm leading-relaxed text-stone-700">"Quosel handles the boilerplate so our team can focus on the parts that actually need our skill."</p>
                <p class="mt-3 text-xs text-stone-400">— Dan R., Studio director</p>
              </div>
            </div>

          </div>

          <!-- Tab bar -->
          <div class="border-t border-stone-200">
            <div class="flex divide-x divide-stone-200">

              <button class="uc-tab uc-tab-active flex flex-1 items-center justify-center gap-2.5 px-6 py-5 text-sm font-medium text-stone-800 bg-white/60 transition-colors" data-target="freelancer">
                <span class="uc-icon shrink-0 text-[#c44a2b]">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                Freelancer
              </button>

              <button class="uc-tab flex flex-1 items-center justify-center gap-2.5 px-6 py-5 text-sm font-medium text-stone-500 transition-colors hover:bg-white/40" data-target="agency">
                <span class="uc-icon shrink-0 text-stone-400">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </span>
                Agency
              </button>

              <button class="uc-tab flex flex-1 items-center justify-center gap-2.5 px-6 py-5 text-sm font-medium text-stone-500 transition-colors hover:bg-white/40" data-target="studio">
                <span class="uc-icon shrink-0 text-stone-400">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
                </span>
                Web Studio
              </button>

            </div>
          </div>

        </div>
      </div>

      <script>
        const ucTabs = document.querySelectorAll<HTMLElement>('.uc-tab');
        const ucPanels = document.querySelectorAll<HTMLElement>('.uc-panel');
        const ucQuotes = document.querySelectorAll<HTMLElement>('.uc-quote');

        ucTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const target = (tab as HTMLElement).dataset.target!;

            ucTabs.forEach(t => {
              t.classList.remove('uc-tab-active', 'bg-white/60', 'text-stone-800');
              t.classList.add('text-stone-500');
              const icon = t.querySelector<HTMLElement>('.uc-icon');
              if (icon) { icon.style.color = ''; icon.classList.remove('text-[#c44a2b]'); icon.classList.add('text-stone-400'); }
            });
            tab.classList.add('uc-tab-active', 'bg-white/60', 'text-stone-800');
            tab.classList.remove('text-stone-500');
            const activeIcon = tab.querySelector<HTMLElement>('.uc-icon');
            if (activeIcon) { activeIcon.style.color = '#c44a2b'; activeIcon.classList.remove('text-stone-400'); }

            ucPanels.forEach(p => p.classList.add('hidden'));
            document.getElementById(`uc-${target}`)?.classList.remove('hidden');

            ucQuotes.forEach(q => q.classList.add('hidden'));
            document.getElementById(`quote-${target}`)?.classList.remove('hidden');
          });
        });
      </script>

