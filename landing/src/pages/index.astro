---
import Footer from '../components/footer.astro';
import Layout from '../layouts/Layout.astro';
import BuiltWith from './built-with.astro';
import ClosingCTA from './closing-cta.astro';
import EditorDemo from './editor-demo.astro';
import FAQ from './faq.astro';
import Features from './features.astro';
import Header from './header.astro';
import Hero from './hero.astro';
import Pricing from './princing.astro';
import Showcase from './showcase.astro';
---

<Layout>
  <Header />

  <main class="border-border flex w-[90%] max-w-7xl flex-col items-center justify-center border-x">
    <Hero />
    <Features />
    <Showcase />
    <EditorDemo />
    <BuiltWith />
    <FAQ />
    <Pricing />
    <ClosingCTA />
    <Footer />
  </main>
</Layout>
