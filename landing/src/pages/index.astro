---
import Layout from "../layouts/Layout.astro";

const appUrl = "https://app.quosel.com";

const navLinks = [
  { label: "Features", href: "#features" },
  { label: "How it works", href: "#how" },
  { label: "Testimonials", href: "#testimonials" },
  { label: "Pricing", href: "#pricing" },
  { label: "Blog", href: "#blog" },
];

const tabs = [
  { label: "URL Import", icon: "↗" },
  //  { label: "Business Info", icon: "🏢" },
  //  { label: "Auto Layout", icon: "⊞" },
  //  { label: "Review Import", icon: "★" },
  //  { label: "Mobile Ready", icon: "📱" },
  //  { label: "White Label", icon: "🏷" },
];
---

<Layout>
  <!-- Navbar -->
  <header
    class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-sm"
  >
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div
          class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-primary-foreground"
        >
          Q
        </div>
        <span
          class="text-base font-semibold tracking-tight text-card-foreground"
          >Quosel</span
        >
      </a>

      <!-- Nav links -->
      <div
        class="hidden items-center gap-7 text-sm text-muted-foreground md:flex"
      >
        {
          navLinks.map(({ label, href }) => (
            <a href={href} class="hover:text-foreground transition-colors">
              {label}
            </a>
          ))
        }
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          class="flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-card text-muted-foreground hover:bg-muted transition-colors cursor-pointer"
        >
          <!-- Moon: shown in light mode -->
          <svg
            id="icon-moon"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <!-- Sun: shown in dark mode -->
          <svg
            id="icon-sun"
            class="hidden"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle><line
              x1="12"
              y1="1"
              x2="12"
              y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line
              x1="4.22"
              y1="4.22"
              x2="5.64"
              y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
            ></line><line x1="1" y1="12" x2="3" y2="12"></line><line
              x1="21"
              y1="12"
              x2="23"
              y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
            ></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
        <a
          href={appUrl}
          class="rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors"
        >
          Sign up
        </a>
      </div>
    </nav>
  </header>

  <main class="bg-background">
    <!-- Hero -->
    <section class="mx-auto max-w-4xl px-6 pb-0 pt-20 text-center">
      <!-- Badge -->
      <div
        class="mb-8 inline-flex items-center gap-2 rounded-full bg-muted px-4 py-1.5 text-sm"
      >
        <span
          class="flex items-center gap-1 rounded-full bg-primary px-2 py-0.5 text-xs font-semibold text-primary-foreground"
        >
          🔥 New
        </span>
        <span class="text-secondary-foreground"
          >Introducing AI-powered pages</span
        >
      </div>

      <!-- Heading -->
      <h1
        class="mx-auto max-w-3xl text-5xl font-bold leading-tight tracking-tight text-card-foreground sm:text-6xl"
      >
        Turn any Google Maps link into a ready-to-ship landing page.
      </h1>

      <!-- Subtext -->
      <p
        class="mx-auto mt-6 max-w-2xl text-base text-muted-foreground sm:text-lg"
      >
        Paste a URL, get a polished site with photos, reviews, and contact info
        — auto-imported and ready to deliver the same day.
      </p>

      <!-- CTAs -->
      <div
        class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <a
          href={appUrl}
          class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
          Get Started
        </a>
        <a
          href="#pricing"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3 text-base font-semibold text-foreground shadow-sm hover:bg-muted transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="12" y1="1" x2="12" y2="23"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          View Pricing
        </a>
      </div>

      <!-- Social proof -->
      <div
        class="mt-10 flex flex-col items-center justify-center gap-6 sm:flex-row sm:gap-8"
      >
        <!-- Users -->
        <div class="flex items-center gap-3">
          <div class="flex -space-x-2">
            {
              ["#c96442", "#2b7ac4", "#2bc47a", "#c4b12b"].map((color, i) => (
                <div
                  class="h-8 w-8 rounded-full border-2 border-background flex items-center justify-center text-xs font-bold text-white"
                  style={`background-color: ${color}; z-index: ${4 - i}`}
                >
                  {String.fromCharCode(65 + i)}
                </div>
              ))
            }
          </div>
          <span class="text-sm font-medium text-foreground">12K+ Users</span>
        </div>

        <div class="hidden h-4 w-px bg-border sm:block"></div>

        <!-- Ratings -->
        <div class="flex items-center gap-2">
          <div class="flex text-[#f59e0b]">
            {"★★★★".split("").map(() => <span>★</span>)}
            <span class="text-muted-foreground">★</span>
          </div>
          <span class="text-sm font-medium text-foreground">4.5 Ratings</span>
        </div>
      </div>
    </section>

    <!-- Feature tabs -->
    <div class="mt-16 border-t border-border">
      <div class="mx-auto max-w-6xl overflow-x-auto">
        <div class="flex min-w-max divide-x divide-border">
          {
            tabs.map(({ label, icon }, i) => (
              <button
                class={[
                  "flex items-center gap-2 px-8 py-5 text-sm font-medium transition-colors whitespace-nowrap",
                  i === 0
                    ? "border-b-2 border-primary bg-card text-card-foreground"
                    : "bg-background text-muted-foreground hover:bg-card hover:text-foreground",
                ].join(" ")}
              >
                <span>{icon}</span>
                {label}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Workflow diagram (tab 1 content) -->
    <div class="overflow-x-auto border-b border-border">
      <div
        class="relative bg-background"
        style="min-width: 1100px; height: 460px;"
      >
        <!-- Dot grid -->
        <div
          class="absolute inset-0"
          style="background-image: radial-gradient(circle, var(--diagram-dot) 1.2px, transparent 1.2px); background-size: 28px 28px;"
        >
        </div>

        <!-- SVG arrows -->
        <svg
          class="absolute inset-0 pointer-events-none"
          width="1100"
          height="460"
          viewBox="0 0 1100 460"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <marker
              id="arr"
              markerWidth="7"
              markerHeight="7"
              refX="5.5"
              refY="3.5"
              orient="auto"
            >
              <path d="M0,1 L0,6 L5,3.5 z" style="fill: var(--diagram-arrow)"
              ></path>
            </marker>
          </defs>
          <path
            d="M 290,155 C 360,155 420,225 420,248"
            style="stroke: var(--diagram-arrow)"
            stroke-width="1.5"
            fill="none"
            marker-end="url(#arr)"></path>
          <path
            d="M 700,255 C 760,255 810,205 810,160"
            style="stroke: var(--diagram-arrow)"
            stroke-width="1.5"
            fill="none"
            marker-end="url(#arr)"></path>
        </svg>

        <!-- Input card -->
        <div
          class="absolute rounded-xl border border-border bg-card shadow-sm overflow-hidden"
          style="left:30px;top:30px;width:260px;"
        >
          <div class="px-3 pt-3">
            <span
              class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-600 dark:bg-blue-950 dark:text-blue-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 20h9"></path><path
                  d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                ></path></svg
              >
              Input
            </span>
          </div>
          <div class="flex items-start justify-between px-3 pt-2 pb-1">
            <div>
              <div
                class="flex items-center gap-1.5 text-sm font-semibold text-foreground"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-muted-foreground"
                  ><path
                    d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                  ></path><polyline points="14 2 14 8 20 8"></polyline></svg
                >
                Google Maps URL
              </div>
              <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                Paste any business link to auto-import all data.
              </p>
            </div>
            <span class="text-muted-foreground text-base leading-none mt-0.5"
              >⋮</span
            >
          </div>
          <div class="border-t border-border bg-muted px-3 py-3">
            <p class="mb-2 text-xs font-medium text-amber-500">
              Fetching data...
            </p>
            <div
              class="mb-3 h-1.5 w-full overflow-hidden rounded-full bg-secondary"
            >
              <div class="h-full rounded-full bg-amber-400" style="width:62%;">
              </div>
            </div>
            <div class="space-y-1.5">
              <div
                class="flex items-center gap-2 text-xs text-secondary-foreground"
              >
                <span
                  class="flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-green-100 text-[9px] font-bold text-green-600 dark:bg-green-950 dark:text-green-300"
                  >G</span
                >
                Business details
              </div>
              <div
                class="flex items-center gap-2 text-xs text-secondary-foreground"
              >
                <span
                  class="flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-amber-100 text-[9px] text-amber-500 dark:bg-amber-950 dark:text-amber-300"
                  >★</span
                >
                Reviews &amp; ratings
              </div>
              <div
                class="flex items-center gap-2 text-xs text-secondary-foreground"
              >
                <span
                  class="flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-blue-100 text-[9px] text-blue-500 dark:bg-blue-950 dark:text-blue-300"
                  >▣</span
                >
                Place photos
              </div>
            </div>
          </div>
          <div
            class="flex items-center gap-1 border-t border-border px-3 py-2 text-xs text-muted-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="10"
              height="10"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><polyline
                points="12 6 12 12 16 14"></polyline></svg
            >
            0.0 sec
          </div>
        </div>

        <!-- Action card -->
        <div
          class="absolute rounded-xl border border-border bg-card shadow-sm overflow-hidden"
          style="left:420px;top:185px;width:280px;"
        >
          <div class="px-3 pt-3">
            <span
              class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-600 dark:bg-orange-950 dark:text-orange-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="3"></circle><path
                  d="M19.07 4.93a10 10 0 0 1 0 14.14"></path><path
                  d="M4.93 4.93a10 10 0 0 0 0 14.14"></path></svg
              >
              Action
            </span>
          </div>
          <div class="flex items-start justify-between px-3 pt-2 pb-5">
            <div>
              <div
                class="flex items-center gap-1.5 text-sm font-semibold text-foreground"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-muted-foreground"
                  ><line x1="12" y1="5" x2="12" y2="19"></line><polyline
                    points="19 12 12 19 5 12"></polyline><polyline
                    points="19 5 12 12 5 5"></polyline></svg
                >
                Page Generation
              </div>
              <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                AI builds a complete, mobile-ready page from the imported
                business data.
              </p>
            </div>
            <span class="text-muted-foreground text-base leading-none mt-0.5"
              >⋮</span
            >
          </div>
          <div
            class="flex items-center justify-between border-t border-border px-3 py-2"
          >
            <span class="flex items-center gap-1 text-xs text-muted-foreground">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
              1.2 sec
            </span>
            <span
              class="inline-flex items-center gap-1 rounded-full border border-primary/50 px-2.5 py-0.5 text-xs font-medium text-primary"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="9"
                height="9"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="3"></circle><path
                  d="M19.07 4.93a10 10 0 0 1 0 14.14"></path><path
                  d="M4.93 4.93a10 10 0 0 0 0 14.14"></path></svg
              >
              Quosel AI
            </span>
          </div>
        </div>

        <!-- Output card -->
        <div
          class="absolute rounded-xl border border-border bg-card shadow-sm overflow-hidden"
          style="left:810px;top:30px;width:260px;"
        >
          <div class="px-3 pt-3">
            <span
              class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-600 dark:bg-green-950 dark:text-green-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
              Output
            </span>
          </div>
          <div class="flex items-start justify-between px-3 pt-2 pb-1">
            <div>
              <div
                class="flex items-center gap-1.5 text-sm font-semibold text-foreground"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-muted-foreground"
                  ><path
                    d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                  ></path><polyline points="14 2 14 8 20 8"></polyline></svg
                >
                Landing Page
              </div>
              <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                Your polished page is ready to review and deliver.
              </p>
            </div>
            <span class="text-muted-foreground text-base leading-none mt-0.5"
              >⋮</span
            >
          </div>
          <div class="border-t border-border bg-muted px-3 py-3">
            <p class="mb-1.5 text-xs font-semibold text-muted-foreground">
              Preview
            </p>
            <p class="text-xs leading-relaxed text-muted-foreground">
              Business photos, reviews, hours, map, and contact form are all
              beautifully laid out.
            </p>
            <div
              class="mt-3 flex items-center gap-2 text-xs text-secondary-foreground"
            >
              <span
                class="flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-secondary text-[9px] text-muted-foreground"
                >▤</span
              >
              page.html exported
            </div>
          </div>
          <div
            class="flex items-center gap-1 border-t border-border px-3 py-2 text-xs text-muted-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="10"
              height="10"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><polyline
                points="12 6 12 12 16 14"></polyline></svg
            >
            0.0 sec
          </div>
        </div>
      </div>
    </div>

    <!-- Use Cases -->
    <section id="use-cases" class="bg-background">
      <!-- Label -->
      <div class="py-10 text-center">
        <p
          class="text-xs font-semibold uppercase tracking-widest text-muted-foreground"
        >
          Use Cases
        </p>
        <p class="mt-1 text-sm text-muted-foreground">
          Practical ways Quosel delivers value to your business.
        </p>
      </div>

      <!-- Bordered content box -->
      <div class="mx-auto max-w-5xl">
        <div class="border-x border-t border-border">
          <!-- Split -->
          <div class="grid grid-cols-1 sm:grid-cols-2">
            <!-- LEFT: tab panels -->
            <div class="border-b border-border sm:border-b-0 sm:border-r">
              <div id="uc-freelancer" class="uc-panel p-10 sm:p-12">
                <h2
                  class="text-3xl font-bold leading-tight tracking-tight text-card-foreground sm:text-4xl"
                >
                  See how we help <span class="text-muted-foreground"
                    >freelancers</span
                  > land clients, <span class="text-muted-foreground"
                    >every</span
                  > week.
                </h2>
                <p class="mt-6 text-sm leading-relaxed text-muted-foreground">
                  Quosel turns any Google Maps link into a pitch-ready landing
                  page. Show prospects exactly what their site could look like —
                  before writing a single line of code. Close deals faster with
                  real deliverables.
                </p>
                <a
                  href={appUrl}
                  class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
                >
                  Learn more
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M7 17L17 7M17 7H7M17 7v10"></path></svg
                  >
                </a>
              </div>

              <div id="uc-agency" class="uc-panel hidden p-10 sm:p-12">
                <h2
                  class="text-3xl font-bold leading-tight tracking-tight text-card-foreground sm:text-4xl"
                >
                  See how <span class="text-muted-foreground">agencies</span> deliver
                  sites for <span class="text-muted-foreground">every</span> client,
                  faster.
                </h2>
                <p class="mt-6 text-sm leading-relaxed text-muted-foreground">
                  Agencies use Quosel to cut production time from days to hours.
                  Auto-import client data, apply your template, and ship —
                  without the back-and-forth on assets and manual data
                  gathering.
                </p>
                <a
                  href={appUrl}
                  class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
                >
                  Learn more
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M7 17L17 7M17 7H7M17 7v10"></path></svg
                  >
                </a>
              </div>

              <div id="uc-studio" class="uc-panel hidden p-10 sm:p-12">
                <h2
                  class="text-3xl font-bold leading-tight tracking-tight text-card-foreground sm:text-4xl"
                >
                  See how studios <span class="text-muted-foreground"
                    >scale</span
                  > output without adding <span class="text-muted-foreground"
                    >headcount</span
                  >.
                </h2>
                <p class="mt-6 text-sm leading-relaxed text-muted-foreground">
