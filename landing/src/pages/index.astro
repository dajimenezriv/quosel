---
import Layout from '../layouts/Layout.astro';

const appUrl = 'https://app.quosel.com';
---

<Layout>
	<!-- Navbar -->
	<header class="border-b border-slate-200">
		<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
			<a href="/" class="text-xl font-semibold tracking-tight">Quosel</a>
			<div class="flex items-center gap-6 text-sm">
				<a href="#how" class="hidden text-slate-600 hover:text-slate-900 sm:inline">How it works</a>
				<a href="#pricing" class="hidden text-slate-600 hover:text-slate-900 sm:inline">Pricing</a>
				<a
					href={appUrl}
					class="rounded-lg bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-800"
				>
					Try free
				</a>
			</div>
		</nav>
	</header>

	<main>
		<!-- 1. Hero -->
		<section class="mx-auto max-w-4xl px-6 pt-24 pb-20 text-center">
			<h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl">
				Turn any Google Maps link into a ready-to-deliver landing page.
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
				For freelancers and agencies who sell websites to local businesses. Paste the URL, ship the
				site the same day.
			</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a
					href={appUrl}
					class="rounded-lg bg-slate-900 px-6 py-3 text-base font-medium text-white hover:bg-slate-800"
				>
					Try 3 URLs free
				</a>
				<a
					href="#how"
					class="rounded-lg border border-slate-300 px-6 py-3 text-base font-medium text-slate-700 hover:bg-slate-50"
				>
					See how it works
				</a>
			</div>
			<p class="mt-4 text-sm text-slate-500">No card required · €5/month after your 3 free URLs</p>
		</section>

		<!-- 2. Social proof / credibility -->
		<section class="border-y border-slate-200 bg-slate-50">
			<div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-6 py-8 text-center sm:flex-row sm:justify-center sm:gap-10">
				<span class="text-sm font-medium uppercase tracking-wider text-slate-500">
					Built by indie devs · Powered by Google Places
				</span>
			</div>
		</section>

		<!-- 3. How it works -->
		<section id="how" class="mx-auto max-w-6xl px-6 py-24">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">From URL to live site in 3 steps</h2>
				<p class="mt-4 text-slate-600">
					Skip the kickoff calls, asset gathering, and weeks of revisions.
				</p>
			</div>

			<div class="mt-16 grid gap-8 sm:grid-cols-3">
				<div class="rounded-2xl border border-slate-200 p-6">
					<div class="mb-4 inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold text-white">
						1
					</div>
					<h3 class="text-lg font-semibold">Paste the Google Maps URL</h3>
					<p class="mt-2 text-sm text-slate-600">
						Drop any business link. Quosel pulls name, photos, hours, reviews and contact info.
					</p>
				</div>

				<div class="rounded-2xl border border-slate-200 p-6">
					<div class="mb-4 inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold text-white">
						2
					</div>
					<h3 class="text-lg font-semibold">We generate the page</h3>
					<p class="mt-2 text-sm text-slate-600">
						Hero, gallery, reviews, map, contact form — laid out, styled, mobile-ready.
					</p>
				</div>

				<div class="rounded-2xl border border-slate-200 p-6">
					<div class="mb-4 inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold text-white">
						3
					</div>
					<h3 class="text-lg font-semibold">Deliver to your client</h3>
					<p class="mt-2 text-sm text-slate-600">
						Tweak copy and colors, publish to your domain, invoice the client. Done.
					</p>
				</div>
			</div>
		</section>

		<!-- 4. Pricing -->
		<section id="pricing" class="border-t border-slate-200 bg-slate-50">
			<div class="mx-auto max-w-6xl px-6 py-24">
				<div class="mx-auto max-w-2xl text-center">
					<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">One plan. No surprises.</h2>
					<p class="mt-4 text-slate-600">Charge clients hundreds. Pay €5.</p>
				</div>

				<div class="mx-auto mt-12 max-w-md rounded-2xl border border-slate-900 bg-white p-8 shadow-sm">
					<h3 class="text-lg font-semibold">Quosel Pro</h3>
					<div class="mt-4 flex items-baseline gap-1">
						<span class="text-5xl font-bold tracking-tight">€5</span>
						<span class="text-slate-500">/month</span>
					</div>
					<p class="mt-2 text-sm text-slate-600">First 3 Google Maps URLs free. Cancel anytime.</p>

					<ul class="mt-6 space-y-3 text-sm">
						<li class="flex items-start gap-2">
							<span class="text-slate-900">✓</span>
							<span>Unlimited landing pages</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-slate-900">✓</span>
							<span>Auto-imported photos, reviews, hours</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-slate-900">✓</span>
							<span>Custom domains</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-slate-900">✓</span>
							<span>Export HTML or host with us</span>
						</li>
					</ul>

					<a
						href={appUrl}
						class="mt-8 block w-full rounded-lg bg-slate-900 px-6 py-3 text-center text-base font-medium text-white hover:bg-slate-800"
					>
						Try 3 URLs free
					</a>
				</div>
			</div>
		</section>

		<!-- 5. Closing CTA -->
		<section class="mx-auto max-w-4xl px-6 py-24 text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
				Ship the next client site this afternoon.
			</h2>
			<p class="mx-auto mt-4 max-w-xl text-slate-600">
				Paste a URL, deliver a polished site, get paid. First 3 URLs free, €5/month after.
			</p>
			<div class="mt-8 flex justify-center">
				<a
					href={appUrl}
					class="rounded-lg bg-slate-900 px-6 py-3 text-base font-medium text-white hover:bg-slate-800"
				>
					Try 3 URLs free
				</a>
			</div>
		</section>
	</main>

	<footer class="border-t border-slate-200">
		<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-6 py-8 text-sm text-slate-500 sm:flex-row">
			<span>© {new Date().getFullYear()} Quosel</span>
			<div class="flex gap-6">
				<a href="#" class="hover:text-slate-900">Terms</a>
				<a href="#" class="hover:text-slate-900">Privacy</a>
				<a href="mailto:hello@quosel.com" class="hover:text-slate-900">Contact</a>
			</div>
		</div>
	</footer>
</Layout>
