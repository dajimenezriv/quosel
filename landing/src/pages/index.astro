---
import Moon from '../assets/moon.svg';
import Sun from '../assets/sun.svg';
import Layout from '../layouts/Layout.astro';
import ClosingCTA from './closing-cta.astro';
import FAQ from './faq.astro';
import Hero from './hero.astro';
import Pricing from './princing.astro';
import UseCases from './use-cases.astro';
import WorkflowDiagram from './workflow-diagram.astro';

const appUrl = 'https://app.quosel.com';

const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'How it works', href: '#how' },
  { label: 'Testimonials', href: '#testimonials' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'Blog', href: '#blog' },
];

const tabs = [
  { label: 'URL Import', icon: '↗' },
  //  { label: "Business Info", icon: "🏢" },
  //  { label: "Auto Layout", icon: "⊞" },
  //  { label: "Review Import", icon: "★" },
  //  { label: "Mobile Ready", icon: "📱" },
  //  { label: "White Label", icon: "🏷" },
];
---

<Layout>
  <!-- Navbar -->
  <header class="border-border bg-background/80 sticky top-0 z-50 border-b backdrop-blur-sm">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-lg text-sm font-bold">Q</div>
        <span class="text-card-foreground text-base font-semibold tracking-tight">Quosel</span>
      </a>

      <!-- Nav links -->
      <div class="text-muted-foreground hidden items-center gap-7 text-sm md:flex">
        {
          navLinks.map(({ label, href }) => (
            <a href={href} class="hover:text-foreground transition-colors">
              {label}
            </a>
          ))
        }
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          class="border-border bg-card text-muted-foreground hover:bg-muted flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border transition-colors">
          <!-- Moon: shown in light mode -->
          <Moon />
          <!-- Sun: shown in dark mode -->
          <Sun />
        </button>
        <a
          href={appUrl}
          class="border-border bg-card text-foreground hover:bg-muted rounded-lg border px-4 py-2 text-sm font-medium transition-colors">
          Sign up
        </a>
      </div>
    </nav>
  </header>

  <main class="bg-background">
    <Hero />

    <!-- Feature tabs -->
    <div class="border-border mt-16 border-t">
      <div class="mx-auto max-w-6xl overflow-x-auto">
        <div class="divide-border flex min-w-max divide-x">
          {
            tabs.map(({ label, icon }, i) => (
              <button
                class={[
                  'flex items-center gap-2 px-8 py-5 text-sm font-medium whitespace-nowrap transition-colors',
                  i === 0
                    ? 'border-primary bg-card text-card-foreground border-b-2'
                    : 'bg-background text-muted-foreground hover:bg-card hover:text-foreground',
                ].join(' ')}>
                <span>{icon}</span>
                {label}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <WorkflowDiagram />
    <UseCases />
    <Pricing />
    <FAQ />
    <ClosingCTA />
  </main>

  <!-- Footer -->
  <footer class="border-border bg-card border-t">
    <div class="text-muted-foreground mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-6 py-8 text-sm sm:flex-row">
      <span>© {new Date().getFullYear()} Quosel</span>
      <div class="flex gap-6">
        <a href="#" class="hover:text-foreground transition-colors">Terms</a>
        <a href="#" class="hover:text-foreground transition-colors">Privacy</a>
        <a href="mailto:hello@quosel.com" class="hover:text-foreground transition-colors">Contact</a>
      </div>
    </div>
  </footer>

  <!-- Theme toggle script -->
  <script>
    const toggle = document.getElementById('theme-toggle')!;
    const moon = document.getElementById('icon-moon')!;
    const sun = document.getElementById('icon-sun')!;

    // Sync icon with current state
    function syncIcon() {
      const isDark = document.documentElement.classList.contains('dark');
      moon.classList.toggle('hidden', isDark);
      sun.classList.toggle('hidden', !isDark);
    }
    syncIcon();

    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      syncIcon();
    });
  </script>
</Layout>
