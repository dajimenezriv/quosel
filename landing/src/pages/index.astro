---
import Layout from '../layouts/Layout.astro';

const appUrl = 'https://app.quosel.com';

const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'How it works', href: '#how' },
  { label: 'Testimonials', href: '#testimonials' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'Blog', href: '#blog' },
];

const tabs = [
  { label: 'URL Import', icon: '↗' },
  { label: 'Business Info', icon: '🏢' },
  { label: 'Auto Layout', icon: '⊞' },
  { label: 'Review Import', icon: '★' },
  { label: 'Mobile Ready', icon: '📱' },
  { label: 'White Label', icon: '🏷' },
];
---

<Layout>
  <!-- Navbar -->
  <header class="sticky top-0 z-50 border-b border-stone-200/60 bg-[#faf7f2]/80 backdrop-blur-sm">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#c44a2b] text-sm font-bold text-white">
          Q
        </div>
        <span class="text-base font-semibold tracking-tight text-stone-900">Quosel</span>
      </a>

      <!-- Nav links -->
      <div class="hidden items-center gap-7 text-sm text-stone-600 md:flex">
        {navLinks.map(({ label, href }) => (
          <a href={href} class="hover:text-stone-900 transition-colors">{label}</a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <button
          aria-label="Toggle dark mode"
          class="flex h-9 w-9 items-center justify-center rounded-lg border border-stone-300 bg-white text-stone-600 hover:bg-stone-50 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <a
          href={appUrl}
          class="rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-800 hover:bg-stone-50 transition-colors"
        >
          Sign up
        </a>
      </div>
    </nav>
  </header>

  <main class="bg-[#faf7f2]">
    <!-- Hero -->
    <section class="mx-auto max-w-4xl px-6 pb-0 pt-20 text-center">
      <!-- Badge -->
      <div class="mb-8 inline-flex items-center gap-2 rounded-full bg-stone-200/70 px-4 py-1.5 text-sm">
        <span class="flex items-center gap-1 rounded-full bg-[#c44a2b] px-2 py-0.5 text-xs font-semibold text-white">
          🔥 New
        </span>
        <span class="text-stone-600">Introducing AI-powered pages</span>
      </div>

      <!-- Heading -->
      <h1 class="mx-auto max-w-3xl text-5xl font-bold leading-tight tracking-tight text-stone-900 sm:text-6xl">
        Turn any Google Maps link into a ready-to-ship landing page.
      </h1>

      <!-- Subtext -->
      <p class="mx-auto mt-6 max-w-2xl text-base text-stone-500 sm:text-lg">
        Paste a URL, get a polished site with photos, reviews, and contact info — auto-imported and ready to deliver the same day.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={appUrl}
          class="inline-flex items-center gap-2 rounded-lg bg-[#c44a2b] px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#b03d23] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
          Get Started
        </a>
        <a
          href="#pricing"
          class="inline-flex items-center gap-2 rounded-lg border border-stone-300 bg-white px-6 py-3 text-base font-semibold text-stone-700 shadow-sm hover:bg-stone-50 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
          View Pricing
        </a>
      </div>

      <!-- Social proof -->
      <div class="mt-10 flex flex-col items-center justify-center gap-6 sm:flex-row sm:gap-8">
        <!-- Users -->
        <div class="flex items-center gap-3">
          <div class="flex -space-x-2">
            {['#c44a2b','#2b7ac4','#2bc47a','#c4b12b'].map((color, i) => (
              <div
                class="h-8 w-8 rounded-full border-2 border-[#faf7f2] flex items-center justify-center text-xs font-bold text-white"
                style={`background-color: ${color}; z-index: ${4 - i}`}
              >
                {String.fromCharCode(65 + i)}
              </div>
            ))}
          </div>
          <span class="text-sm font-medium text-stone-700">12K+ Users</span>
        </div>

        <div class="hidden h-4 w-px bg-stone-300 sm:block"></div>

        <!-- Ratings -->
        <div class="flex items-center gap-2">
          <div class="flex text-[#f59e0b]">
            {'★★★★'.split('').map(() => <span>★</span>)}
            <span class="text-stone-300">★</span>
          </div>
          <span class="text-sm font-medium text-stone-700">4.5 Ratings</span>
        </div>
      </div>
    </section>

    <!-- Feature tabs -->
    <div class="mt-16 border-t border-stone-200/80">
      <div class="mx-auto max-w-6xl overflow-x-auto">
        <div class="flex min-w-max divide-x divide-stone-200/80">
          {tabs.map(({ label, icon }, i) => (
            <button
              class={[
                'flex items-center gap-2 px-8 py-5 text-sm font-medium transition-colors whitespace-nowrap',
                i === 0
                  ? 'border-b-2 border-[#c44a2b] bg-white text-stone-900'
                  : 'bg-[#faf7f2] text-stone-500 hover:bg-white hover:text-stone-800'
              ].join(' ')}
            >
              <span>{icon}</span>
              {label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- How it works -->
    <section id="how" class="mx-auto max-w-6xl px-6 py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">From URL to live site in 3 steps</h2>
        <p class="mt-4 text-stone-500">Skip the kickoff calls, asset gathering, and weeks of revisions.</p>
      </div>

      <div class="mt-16 grid gap-6 sm:grid-cols-3">
        {[
          { n: 1, title: 'Paste the Google Maps URL', body: 'Drop any business link. Quosel pulls name, photos, hours, reviews and contact info automatically.' },
          { n: 2, title: 'We generate the page', body: 'Hero, gallery, reviews, map, contact form — laid out, styled, and mobile-ready in seconds.' },
          { n: 3, title: 'Deliver to your client', body: 'Tweak copy and colors, publish to your domain, invoice the client. Done.' },
        ].map(({ n, title, body }) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-7 shadow-sm">
            <div class="mb-5 inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#c44a2b] text-sm font-bold text-white">
              {n}
            </div>
            <h3 class="text-base font-semibold text-stone-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-500">{body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="border-t border-stone-200/80 bg-white">
      <div class="mx-auto max-w-6xl px-6 py-24">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">One plan. No surprises.</h2>
          <p class="mt-4 text-stone-500">Charge clients hundreds. Pay €5.</p>
        </div>

        <div class="mx-auto mt-12 max-w-md rounded-2xl border border-stone-900 bg-white p-8 shadow-sm">
          <h3 class="text-lg font-semibold text-stone-900">Quosel Pro</h3>
          <div class="mt-4 flex items-baseline gap-1">
            <span class="text-5xl font-bold tracking-tight text-stone-900">€5</span>
            <span class="text-stone-500">/month</span>
          </div>
          <p class="mt-2 text-sm text-stone-500">First 3 Google Maps URLs free. Cancel anytime.</p>

          <ul class="mt-6 space-y-3 text-sm text-stone-700">
            {[
              'Unlimited landing pages',
              'Auto-imported photos, reviews, hours',
              'Custom domains',
              'Export HTML or host with us',
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="font-semibold text-[#c44a2b]">✓</span>
                {item}
              </li>
            ))}
          </ul>

          <a
            href={appUrl}
            class="mt-8 block w-full rounded-lg bg-[#c44a2b] px-6 py-3 text-center text-base font-semibold text-white hover:bg-[#b03d23] transition-colors"
          >
            Try 3 URLs free
          </a>
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="bg-[#faf7f2] mx-auto max-w-4xl px-6 py-24 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">
        Ship the next client site this afternoon.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-stone-500">
        Paste a URL, deliver a polished site, get paid. First 3 URLs free, €5/month after.
      </p>
      <div class="mt-8 flex justify-center">
        <a
          href={appUrl}
          class="inline-flex items-center gap-2 rounded-lg bg-[#c44a2b] px-6 py-3 text-base font-semibold text-white hover:bg-[#b03d23] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
          Get Started Free
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-stone-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-6 py-8 text-sm text-stone-400 sm:flex-row">
      <span>© {new Date().getFullYear()} Quosel</span>
      <div class="flex gap-6">
        <a href="#" class="hover:text-stone-700 transition-colors">Terms</a>
        <a href="#" class="hover:text-stone-700 transition-colors">Privacy</a>
        <a href="mailto:hello@quosel.com" class="hover:text-stone-700 transition-colors">Contact</a>
      </div>
    </div>
  </footer>
</Layout>
