          '[data-price="monthly"]',
        );
        const yearlyEls = document.querySelectorAll<HTMLElement>(
          '[data-price="yearly"]',
        );

        function activate(active: HTMLElement, inactive: HTMLElement) {
          active.classList.add("bg-card", "text-card-foreground", "shadow-sm");
          active.classList.remove("text-muted-foreground");
          inactive.classList.remove(
            "bg-card",
            "text-card-foreground",
            "shadow-sm",
          );
          inactive.classList.add("text-muted-foreground");
        }

        btnMonthly.addEventListener("click", () => {
          activate(btnMonthly, btnYearly);
          monthlyEls.forEach((el) => el.classList.remove("hidden"));
          yearlyEls.forEach((el) => el.classList.add("hidden"));
        });

        btnYearly.addEventListener("click", () => {
          activate(btnYearly, btnMonthly);
          yearlyEls.forEach((el) => el.classList.remove("hidden"));
          monthlyEls.forEach((el) => el.classList.add("hidden"));
