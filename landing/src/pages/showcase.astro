---
import { Image } from 'astro:assets';
import circoloPreview from '../assets/circolo-popolare.png';
import BrowserShowcase from '../components/browser-showcase.astro';

const liveUrl = 'https://sites.quosel.com/circolo-popolare';
---

<BrowserShowcase
  id="showcase"
  title="Live Example"
  description="A real local-business site built with Quosel — see it live."
  url="sites.quosel.com/circolo-popolare"
  href={liveUrl}
  linkLabel="View live">
  <svg
    slot="icon"
    xmlns="http://www.w3.org/2000/svg"
    width="11"
    height="11"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="shrink-0 text-green-500"
    ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
  >

  <Image src={circoloPreview} alt="Circolo Popolare website built with Quosel" width={1280} loading="lazy" class="block w-full" />
</BrowserShowcase>
