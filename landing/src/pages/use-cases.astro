---
const appUrl = 'https://app.quosel.com';
---

<section id="use-cases" class="bg-background">
  <!-- Label -->
  <div class="py-10 text-center">
    <p class="text-muted-foreground text-xs font-semibold tracking-widest uppercase">Use Cases</p>
    <p class="text-muted-foreground mt-1 text-sm">Practical ways Quosel delivers value to your business.</p>
  </div>

  <!-- Bordered content box -->
  <div class="mx-auto max-w-5xl">
    <div class="border-border border-x border-t">
      <!-- Split -->
      <div class="grid grid-cols-1 sm:grid-cols-2">
        <!-- LEFT: tab panels -->
        <div class="border-border border-b sm:border-r sm:border-b-0">
          <div id="uc-freelancer" class="uc-panel p-10 sm:p-12">
            <h2 class="text-card-foreground text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
              See how we help <span class="text-muted-foreground">freelancers</span> land clients, <span class="text-muted-foreground"
                >every</span
              > week.
            </h2>
            <p class="text-muted-foreground mt-6 text-sm leading-relaxed">
              Quosel turns any Google Maps link into a pitch-ready landing page. Show prospects exactly what their site could look like —
              before writing a single line of code. Close deals faster with real deliverables.
            </p>
            <a href={appUrl} class="text-primary mt-6 inline-flex items-center gap-1 text-sm font-medium hover:underline">
              Learn more
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"></path></svg
              >
            </a>
          </div>

          <div id="uc-agency" class="uc-panel hidden p-10 sm:p-12">
            <h2 class="text-card-foreground text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
              See how <span class="text-muted-foreground">agencies</span> deliver sites for <span class="text-muted-foreground">every</span> client,
              faster.
            </h2>
            <p class="text-muted-foreground mt-6 text-sm leading-relaxed">
              Agencies use Quosel to cut production time from days to hours. Auto-import client data, apply your template, and ship —
              without the back-and-forth on assets and manual data gathering.
            </p>
            <a href={appUrl} class="text-primary mt-6 inline-flex items-center gap-1 text-sm font-medium hover:underline">
              Learn more
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"></path></svg
              >
            </a>
          </div>

          <div id="uc-studio" class="uc-panel hidden p-10 sm:p-12">
            <h2 class="text-card-foreground text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
              See how studios <span class="text-muted-foreground">scale</span> output without adding <span class="text-muted-foreground"
                >headcount</span
              >.
            </h2>
            <p class="text-muted-foreground mt-6 text-sm leading-relaxed">
              Web studios use Quosel to handle the heavy lifting — import, layout, mobile optimization — so their team stays focused on
              craft and the work that actually needs their expertise.
            </p>
            <a href={appUrl} class="text-primary mt-6 inline-flex items-center gap-1 text-sm font-medium hover:underline">
              Learn more
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"></path></svg
              >
            </a>
          </div>
        </div>

        <!-- RIGHT: visual + quote -->
        <div
          class="relative min-h-80 overflow-hidden bg-linear-to-br from-stone-300 via-stone-200 to-amber-100 dark:from-stone-800 dark:via-stone-700 dark:to-stone-900">
          <div class="absolute -top-12 -right-12 h-56 w-56 rounded-full bg-white/20"></div>
          <div class="absolute -bottom-20 -left-20 h-72 w-72 rounded-full bg-white/10"></div>
          <div class="absolute top-1/3 right-1/3 h-28 w-28 rounded-full bg-white/10"></div>

          <div id="quote-freelancer" class="uc-quote bg-card absolute right-6 bottom-6 max-w-65 rounded-xl p-5 shadow-lg">
            <p class="text-foreground text-sm leading-relaxed">
              "I show a real page during the first call. My close rate doubled in the first month."
            </p>
            <p class="text-muted-foreground mt-3 text-xs">— Lucas M., Freelance web designer</p>
          </div>
          <div id="quote-agency" class="uc-quote bg-card absolute right-6 bottom-6 hidden max-w-65 rounded-xl p-5 shadow-lg">
            <p class="text-foreground text-sm leading-relaxed">
              "We went from 5-day turnarounds to same-day delivery. Clients absolutely love it."
            </p>
            <p class="text-muted-foreground mt-3 text-xs">— Sarah K., Agency owner</p>
          </div>
          <div id="quote-studio" class="uc-quote bg-card absolute right-6 bottom-6 hidden max-w-65 rounded-xl p-5 shadow-lg">
            <p class="text-foreground text-sm leading-relaxed">
              "Quosel handles the boilerplate so our team can focus on the parts that actually need our skill."
            </p>
            <p class="text-muted-foreground mt-3 text-xs">— Dan R., Studio director</p>
          </div>
        </div>
      </div>

      <!-- Tab bar -->
      <div class="border-border border-t">
        <div class="divide-border flex divide-x">
          <button
            class="uc-tab uc-tab-active text-foreground bg-card/60 flex flex-1 items-center justify-center gap-2.5 px-6 py-5 text-sm font-medium transition-colors"
            data-target="freelancer">
            <span class="uc-icon text-primary shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg
              >
            </span>
            Freelancer
          </button>

          <button
            class="uc-tab text-muted-foreground hover:bg-card/40 flex flex-1 items-center justify-center gap-2.5 px-6 py-5 text-sm font-medium transition-colors"
            data-target="agency">
            <span class="uc-icon text-muted-foreground shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg
              >
            </span>
            Agency
          </button>

          <button
            class="uc-tab text-muted-foreground hover:bg-card/40 flex flex-1 items-center justify-center gap-2.5 px-6 py-5 text-sm font-medium transition-colors"
            data-target="studio">
            <span class="uc-icon text-muted-foreground shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="13.5" cy="6.5" r=".5"></circle><circle cx="17.5" cy="10.5" r=".5"></circle><circle cx="8.5" cy="7.5" r=".5"
                ></circle><circle cx="6.5" cy="12.5" r=".5"></circle><path
                  d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"
                ></path></svg
              >
            </span>
            Web Studio
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const ucTabs = document.querySelectorAll<HTMLElement>('.uc-tab');
    const ucPanels = document.querySelectorAll<HTMLElement>('.uc-panel');
    const ucQuotes = document.querySelectorAll<HTMLElement>('.uc-quote');

    ucTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.target!;

        ucTabs.forEach((t) => {
          t.classList.remove('uc-tab-active', 'bg-card/60', 'text-foreground');
          t.classList.add('text-muted-foreground');
          const icon = t.querySelector<HTMLElement>('.uc-icon');
          if (icon) {
            icon.style.color = '';
            icon.classList.remove('text-primary');
            icon.classList.add('text-muted-foreground');
          }
        });
        tab.classList.add('uc-tab-active', 'bg-card/60', 'text-foreground');
        tab.classList.remove('text-muted-foreground');
        const activeIcon = tab.querySelector<HTMLElement>('.uc-icon');
        if (activeIcon) {
          activeIcon.style.color = 'var(--primary)';
          activeIcon.classList.remove('text-muted-foreground');
        }

        ucPanels.forEach((p) => p.classList.add('hidden'));
        document.getElementById(`uc-${target}`)?.classList.remove('hidden');

        ucQuotes.forEach((q) => q.classList.add('hidden'));
        document.getElementById(`quote-${target}`)?.classList.remove('hidden');
      });
    });
  </script>
</section>
