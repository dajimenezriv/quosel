---
const appUrl = 'https://app.quosel.com';
---

<section class="bg-background mx-auto max-w-4xl px-6 py-24 text-center">
  <h2 class="text-card-foreground text-3xl font-bold tracking-tight sm:text-4xl">Ship the next client site this afternoon.</h2>
  <p class="text-muted-foreground mx-auto mt-4 max-w-xl">
    Paste a URL, deliver a polished site, get paid. First 3 URLs free, €5/month after.
  </p>
  <div class="mt-8 flex justify-center">
    <a
      href={appUrl}
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center gap-2 rounded-lg px-6 py-3 text-base font-semibold transition-colors">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round">
        <path d="M7 17L17 7M17 7H7M17 7v10"></path>
      </svg>
      Get Started Free
    </a>
  </div>
</section>
