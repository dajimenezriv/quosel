        <span class="text-muted-foreground text-base leading-none mt-0.5">⋮</span>
      </div>
      <div class="flex items-center justify-between border-t border-border px-3 py-2">
        <span class="flex items-center gap-1 text-xs text-muted-foreground">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg
