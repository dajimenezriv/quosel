          Output
        </span>
      </div>
      <div class="flex items-start justify-between px-3 pt-2 pb-1">
        <div>
          <div class="flex items-center gap-1.5 text-sm font-semibold text-foreground">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground"
              ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"
              ></polyline></svg
