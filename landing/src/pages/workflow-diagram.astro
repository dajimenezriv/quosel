        <span class="inline-flex items-center gap-1 rounded-full border border-primary/50 px-2.5 py-0.5 text-xs font-medium text-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="9"
            height="9"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="3"></circle><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path><path
              d="M4.93 4.93a10 10 0 0 0 0 14.14"></path></svg
