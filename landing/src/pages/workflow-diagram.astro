        </div>
        <span class="text-muted-foreground text-base leading-none mt-0.5">⋮</span>
      </div>
      <div class="border-t border-border bg-muted px-3 py-3">
        <p class="mb-2 text-xs font-medium text-amber-500">Fetching data...</p>
        <div class="mb-3 h-1.5 w-full overflow-hidden rounded-full bg-secondary">
          <div class="h-full rounded-full bg-amber-400" style="width:62%;"></div>
        </div>
        <div class="space-y-1.5">
          <div class="flex items-center gap-2 text-xs text-secondary-foreground">
            <span
              class="flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-green-100 text-[9px] font-bold text-green-600 dark:bg-green-950 dark:text-green-300"
