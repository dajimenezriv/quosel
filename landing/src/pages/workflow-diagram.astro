<!-- Workflow diagram (tab 1 content) -->
<div class="overflow-x-auto border-b border-border">
  <div class="relative bg-background" style="min-width: 1100px; height: 460px;">
    <!-- Dot grid -->
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(circle, var(--diagram-dot) 1.2px, transparent 1.2px); background-size: 28px 28px;">
    </div>

    <!-- SVG arrows -->
    <svg class="absolute inset-0 pointer-events-none" width="1100" height="460" viewBox="0 0 1100 460" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="arr" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto">
          <path d="M0,1 L0,6 L5,3.5 z" style="fill: var(--diagram-arrow)"></path>
        </marker>
      </defs>
      <path
        d="M 290,155 C 360,155 420,225 420,248"
        style="stroke: var(--diagram-arrow)"
        stroke-width="1.5"
        fill="none"
        marker-end="url(#arr)"></path>
      <path
        d="M 700,255 C 760,255 810,205 810,160"
        style="stroke: var(--diagram-arrow)"
        stroke-width="1.5"
        fill="none"
        marker-end="url(#arr)"></path>
    </svg>

    <!-- Input card -->
    <div class="absolute rounded-xl border border-border bg-card shadow-sm overflow-hidden" style="left:30px;top:30px;width:260px;">
      <div class="px-3 pt-3">
        <span
          class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-600 dark:bg-blue-950 dark:text-blue-300">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg
