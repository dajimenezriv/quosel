---
const appUrl = "https://app.quosel.com";
---

<!-- Pricing -->
    <section id="pricing" class="bg-background py-16">
      <div class="mx-auto max-w-5xl px-6">
        <!-- Label above box -->
        <div class="mb-8 text-center">
          <p
            class="text-xs font-semibold uppercase tracking-widest text-muted-foreground"
          >
            Pricing
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            Flexible plans tailored to scale with your clients.
          </p>
        </div>

        <!-- Main bordered box -->
        <div class="overflow-hidden rounded-2xl border border-border bg-card">
          <!-- Heading + toggle -->
          <div class="px-10 py-12 text-center">
            <h2
              class="text-3xl font-bold tracking-tight text-card-foreground sm:text-4xl"
            >
              Plans that Scale with Your Pages
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-sm text-muted-foreground">
              Find the perfect balance of features and scalability for your
              workflow,<br class="hidden sm:block" />
              designed to help you work smarter and grow effortlessly.
            </p>

            <!-- Monthly / Yearly toggle -->
            <div
              class="mt-7 inline-flex items-center rounded-full border border-border bg-muted p-1"
            >
              <button
                id="btn-monthly"
                class="rounded-full bg-card px-5 py-1.5 text-sm font-medium text-card-foreground shadow-sm transition-all"
              >
                Monthly
              </button>
              <button
                id="btn-yearly"
                class="flex items-center gap-2 rounded-full px-5 py-1.5 text-sm font-medium text-muted-foreground transition-all"
              >
                Yearly
                <span
                  class="rounded-full bg-foreground px-2 py-0.5 text-xs text-background"
                  >Save 35%</span
                >
              </button>
            </div>
          </div>

          <!-- Three plan columns -->
          <div
            class="grid grid-cols-1 divide-y divide-border border-t border-border sm:grid-cols-3 sm:divide-x sm:divide-y-0"
          >
            <!-- Starter -->
            <div class="flex flex-col">
              <div class="border-b border-border p-8">
                <h3 class="text-xl font-bold text-card-foreground">Starter</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                  For freelancers trying out Quosel
                </p>
                <div class="mt-5 flex items-start gap-0.5">
                  <span
                    class="mt-2 text-sm font-medium text-secondary-foreground"
                    >€</span
                  >
                  <span
                    class="text-5xl font-bold tracking-tight text-card-foreground"
                    >0</span
                  >
                  <span class="mt-3 text-sm text-muted-foreground">/month</span>
                </div>
                <a
                  href={appUrl}
                  class="mt-6 block w-full rounded-lg border border-border bg-secondary px-4 py-2.5 text-center text-sm font-medium text-secondary-foreground transition-colors hover:bg-muted"
                >
                  Get started free
                </a>
              </div>
              <ul
                class="flex-1 space-y-4 p-8 text-sm text-secondary-foreground"
              >
                {
                  [
                    "3 landing pages",
                    "Google Maps auto-import",
                    "Standard templates",
                    "Community support",
                    "1 workspace",
                    "Quosel-hosted domain",
                  ].map((f) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                      {f}
                    </li>
                  ))
                }
              </ul>
            </div>

            <!-- Pro -->
            <div class="flex flex-col">
              <div class="border-b border-border p-8">
                <h3 class="text-xl font-bold text-card-foreground">Pro</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                  For freelancers delivering client sites
                </p>
                <div data-price="monthly" class="mt-5 flex items-start gap-0.5">
                  <span
                    class="mt-2 text-sm font-medium text-secondary-foreground"
                    >€</span
                  >
                  <span
                    class="text-5xl font-bold tracking-tight text-card-foreground"
                    >5</span
                  >
                  <span class="mt-3 text-sm text-muted-foreground">/month</span>
                </div>
                <div
                  data-price="yearly"
                  class="mt-5 hidden flex items-start gap-0.5"
                >
                  <span
                    class="mt-2 text-sm font-medium text-secondary-foreground"
                    >€</span
                  >
                  <span
                    class="text-5xl font-bold tracking-tight text-card-foreground"
                    >3</span
                  >
                  <span class="mt-3 text-sm text-muted-foreground">/month</span>
                </div>
                <a
                  href={appUrl}
                  class="mt-6 block w-full rounded-lg bg-primary px-4 py-2.5 text-center text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
                >
                  Purchase plan
                </a>
              </div>
              <ul
                class="flex-1 space-y-4 p-8 text-sm text-secondary-foreground"
              >
                {
                  [
                    "Unlimited landing pages",
                    "Google Maps auto-import",
                    "All templates + AI copy",
                    "Priority email support",
                    "5 client workspaces",
                    "Custom domain",
                    "Export HTML",
                  ].map((f) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                      {f}
                    </li>
                  ))
                }
              </ul>
            </div>

            <!-- Agency -->
            <div class="flex flex-col">
              <div class="border-b border-border p-8">
                <h3 class="text-xl font-bold text-card-foreground">Agency</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                  For agencies needing scale &amp; white-label
                </p>
                <div data-price="monthly" class="mt-5 flex items-start gap-0.5">
                  <span
                    class="mt-2 text-sm font-medium text-secondary-foreground"
                    >€</span
                  >
                  <span
                    class="text-5xl font-bold tracking-tight text-card-foreground"
                    >15</span
                  >
                  <span class="mt-3 text-sm text-muted-foreground">/month</span>
                </div>
                <div
                  data-price="yearly"
                  class="mt-5 hidden flex items-start gap-0.5"
                >
                  <span
                    class="mt-2 text-sm font-medium text-secondary-foreground"
                    >€</span
                  >
                  <span
                    class="text-5xl font-bold tracking-tight text-card-foreground"
                    >10</span
                  >
                  <span class="mt-3 text-sm text-muted-foreground">/month</span>
                </div>
                <a
                  href={appUrl}
                  class="mt-6 block w-full rounded-lg border border-border bg-secondary px-4 py-2.5 text-center text-sm font-medium text-secondary-foreground transition-colors hover:bg-muted"
                >
                  Purchase plan
                </a>
              </div>
              <ul
                class="flex-1 space-y-4 p-8 text-sm text-secondary-foreground"
              >
                {
                  [
                    "Unlimited landing pages",
                    "Everything in Pro",
                    "White-label branding",
                    "Dedicated success manager",
                    "Unlimited client workspaces",
                    "Advanced analytics",
                    "Advanced security & compliance",
                  ].map((f) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                      {f}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>

      <script>
        const btnMonthly = document.getElementById("btn-monthly")!;
        const btnYearly = document.getElementById("btn-yearly")!;
        const monthlyEls = document.querySelectorAll<HTMLElement>(
          '[data-price="monthly"]',
        );
        const yearlyEls = document.querySelectorAll<HTMLElement>(
          '[data-price="yearly"]',
        );

        function activate(active: HTMLElement, inactive: HTMLElement) {
          active.classList.add("bg-card", "text-card-foreground", "shadow-sm");
          active.classList.remove("text-muted-foreground");
          inactive.classList.remove(
            "bg-card",
            "text-card-foreground",
            "shadow-sm",
          );
          inactive.classList.add("text-muted-foreground");
        }

        btnMonthly.addEventListener("click", () => {
          activate(btnMonthly, btnYearly);
          monthlyEls.forEach((el) => el.classList.remove("hidden"));
          yearlyEls.forEach((el) => el.classList.add("hidden"));
        });

        btnYearly.addEventListener("click", () => {
          activate(btnYearly, btnMonthly);
          yearlyEls.forEach((el) => el.classList.remove("hidden"));
          monthlyEls.forEach((el) => el.classList.add("hidden"));
        });
      </script>
    </section>