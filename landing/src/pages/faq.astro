---
import SectionLabel from '../components/section-label.astro';
---

<section id="faq" class="w-full">
  <SectionLabel title="FAQ" description="Description" />

  <div class="mx-auto max-w-5xl p-6">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-16">
      <!-- Product & Features -->
      <div>
        <h3 class="text-primary text-sm font-semibold">Product &amp; Features</h3>
        <div class="divide-border mt-5 divide-y">
          {
            [
              {
                q: 'What exactly is Quosel?',
                a: 'Quosel converts any Google Maps business link into a polished, ready-to-deliver landing page. It auto-imports photos, reviews, hours, and contact info — no manual data entry.',
              },
              {
                q: 'Do I need to install any software?',
                a: 'No installation needed. Quosel is fully web-based — paste a URL in your browser and your page is ready within seconds.',
              },
              {
                q: 'How does the Google Maps import work?',
                a: 'We use the Google Places API to pull all available business data and structure it into a beautiful page automatically.',
              },
              {
                q: 'Can I customize the generated pages?',
                a: 'Yes. After generation you can edit copy, swap photos, adjust colors, and rearrange sections using our simple editor.',
              },
              {
                q: 'What file formats can I export?',
                a: 'Clean HTML/CSS for any host, or publish to a Quosel URL. Custom domains are available on Pro and Agency plans.',
              },
            ].map(({ q, a }, i) => (
              <div class="faq-item">
                <button class="faq-btn flex w-full cursor-pointer items-start justify-between gap-4 pt-4 pb-3 text-left">
                  <span class="text-foreground text-sm font-medium">
                    {i + 1}. {q}
                  </span>
                  <span class="faq-icon text-muted-foreground mt-0.5 shrink-0 text-base leading-none">+</span>
                </button>
                <div class="faq-answer hidden pb-4">
                  <p class="text-muted-foreground text-sm leading-relaxed">{a}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Plans & Usage -->
      <div>
        <h3 class="text-primary text-sm font-semibold">Plans &amp; Usage</h3>
        <div class="divide-border mt-5 divide-y">
          {
            [
              {
                q: 'Can I switch plans anytime?',
                a: 'Yes — upgrade or downgrade instantly. Changes take effect immediately and we prorate any billing difference.',
              },
              {
                q: 'Do you offer a free trial?',
                a: 'Your first 3 landing pages are completely free, no credit card required. Try the full import and generation flow before committing.',
              },
              {
                q: 'What happens if I reach my page limit?',
                a: "On the Starter plan, once you've used your 3 free pages you'll need to upgrade to Pro for unlimited pages. We notify you before you hit the limit.",
              },
              {
                q: 'Can multiple team members use one account?',
                a: 'Pro includes 5 workspaces and Agency includes unlimited workspaces. Each workspace can hold its own client projects and pages.',
              },
              {
                q: 'How is my data kept secure?',
                a: "All data is encrypted in transit (TLS) and at rest. We only store what's needed to generate your page. See our privacy policy for full details.",
              },
            ].map(({ q, a }, i) => (
              <div class="faq-item">
                <button class="faq-btn flex w-full cursor-pointer items-start justify-between gap-4 pt-4 pb-3 text-left">
                  <span class="text-foreground text-sm font-medium">
                    {i + 1}. {q}
                  </span>
                  <span class="faq-icon text-muted-foreground mt-0.5 shrink-0 text-base leading-none">+</span>
                </button>
                <div class="faq-answer hidden pb-4">
                  <p class="text-muted-foreground text-sm leading-relaxed">{a}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('.faq-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest<HTMLElement>('.faq-item')!;
        const answer = item.querySelector<HTMLElement>('.faq-answer')!;
        const icon = btn.querySelector<HTMLElement>('.faq-icon')!;
        const isOpen = !answer.classList.contains('hidden');
        answer.classList.toggle('hidden', isOpen);
        icon.textContent = isOpen ? '+' : '−';
      });
    });
  </script>
</section>
