---
import BuildWorkflow from './workflows/build.astro';
import ShipWorkflow from './workflows/ship.astro';
---

<section id="features" class="w-full">
  <!-- Tab bar -->
  <div class="border-border border-y">
    <div class="divide-border flex divide-x">
      <button
        class="wf-tab wf-tab-active text-foreground bg-card/60 ring-primary flex flex-1 cursor-pointer items-center justify-center gap-2.5 px-6 py-5 text-sm font-medium ring-1 transition-colors ring-inset"
        data-target="build">
        <span class="wf-icon text-foreground shrink-0">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line
              x1="9"
              y1="21"
              x2="9"
              y2="9"></line></svg
          >
        </span>
        Build the site
      </button>

      <button
        class="wf-tab text-muted-foreground hover:bg-card/40 flex flex-1 cursor-pointer items-center justify-center gap-2.5 px-6 py-5 text-sm font-medium transition-colors ring-inset"
        data-target="ship">
        <span class="wf-icon text-muted-foreground shrink-0">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
          >
        </span>
        Approve &amp; publish
      </button>
    </div>
  </div>

  <div id="wf-build" class="wf-panel">
    <BuildWorkflow />
  </div>

  <div id="wf-ship" class="wf-panel hidden">
    <ShipWorkflow />
  </div>

  <script>
    const wfTabs = document.querySelectorAll<HTMLElement>('.wf-tab');
    const wfPanels = document.querySelectorAll<HTMLElement>('.wf-panel');

    wfTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.target!;

        wfTabs.forEach((t) => {
          t.classList.remove('wf-tab-active', 'bg-card/60', 'text-foreground', 'ring-1', 'ring-primary');
          t.classList.add('text-muted-foreground');
          const icon = t.querySelector<HTMLElement>('.wf-icon');
          if (icon) {
            icon.classList.remove('text-foreground');
            icon.classList.add('text-muted-foreground');
          }
        });
        tab.classList.add('wf-tab-active', 'bg-card/60', 'text-foreground', 'ring-1', 'ring-primary');
        tab.classList.remove('text-muted-foreground');
        const activeIcon = tab.querySelector<HTMLElement>('.wf-icon');
        if (activeIcon) {
          activeIcon.classList.add('text-foreground');
          activeIcon.classList.remove('text-muted-foreground');
        }

        wfPanels.forEach((p) => p.classList.add('hidden'));
        document.getElementById(`wf-${target}`)?.classList.remove('hidden');
      });
    });
  </script>
</section>
