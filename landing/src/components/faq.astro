---
import SectionLabel from './section-label.astro';
---

<section id="faq" class="w-full">
  <SectionLabel title="FAQ" description="Answers to the most common questions about building and shipping sites with Quosel." />

  <div class="mx-auto max-w-5xl p-6">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-16">
      <!-- Product & Features -->
      <div>
        <h2 class="text-primary text-sm font-semibold">Product &amp; Features</h2>
        <div class="divide-border mt-5 divide-y">
          {
            [
              {
                q: 'What exactly is Quosel?',
                a: 'Quosel is the fastest way to build local-business sites: start from a modern template, let AI write the copy, upload your images, then share a live link so the client can polish it with you before you publish.',
              },
              {
                q: 'Do I need to install any software?',
                a: 'No installation needed. Quosel is fully web-based — build, share, and publish right from your browser.',
              },
              {
                q: 'How does the AI copy work?',
                a: 'Quosel drafts tailored copy for every block — hero, services, about, and more — from the business details, so you start with a real first draft instead of a blank page.',
              },
              {
                q: 'Can my client edit the site themselves?',
                a: "Yes. Share a public link and your client can refine the copy in real time, watching changes update live. When you're both happy, you hit Publish.",
              },
              {
                q: 'How do I publish the finished site?',
                a: "One click. Quosel publishes the site to the client's own custom domain — no manual hosting or file wrangling. Custom domains are available on the Freelancer plan.",
              },
            ].map(({ q, a }, i) => (
              <div class="faq-item">
                <button class="faq-btn flex w-full cursor-pointer items-start justify-between gap-4 pt-4 pb-3 text-left">
                  <span class="text-foreground text-sm font-medium">
                    {i + 1}. {q}
                  </span>
                  <span class="faq-icon text-muted-foreground mt-0.5 shrink-0 text-base leading-none">+</span>
                </button>
                <div class="faq-answer hidden pb-4">
                  <p class="text-muted-foreground text-sm leading-relaxed">{a}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Plans & Usage -->
      <div>
        <h2 class="text-primary text-sm font-semibold">Plans &amp; Usage</h2>
        <div class="divide-border mt-5 divide-y">
          {
            [
              {
                q: 'Can I switch plans anytime?',
                a: 'Yes — upgrade or downgrade instantly. Changes take effect immediately and we prorate any billing difference.',
              },
              {
                q: 'Do you offer a free trial?',
                a: 'Your first site is completely free, no credit card required. Try the full build-and-publish flow before committing.',
              },
              {
                q: 'What happens if I reach my site limit?',
                a: "On the Free plan, once you've used your free site you'll need to upgrade to Freelancer for up to 10 sites. We notify you before you hit the limit.",
              },
              {
                q: 'How is my data kept secure?',
                a: "All data is encrypted in transit (TLS) and at rest. We only store what's needed to build and publish your site. See our privacy policy for full details.",
              },
            ].map(({ q, a }, i) => (
              <div class="faq-item">
                <button class="faq-btn flex w-full cursor-pointer items-start justify-between gap-4 pt-4 pb-3 text-left">
                  <span class="text-foreground text-sm font-medium">
                    {i + 1}. {q}
                  </span>
                  <span class="faq-icon text-muted-foreground mt-0.5 shrink-0 text-base leading-none">+</span>
                </button>
                <div class="faq-answer hidden pb-4">
                  <p class="text-muted-foreground text-sm leading-relaxed">{a}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('.faq-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest<HTMLElement>('.faq-item')!;
        const answer = item.querySelector<HTMLElement>('.faq-answer')!;
        const icon = btn.querySelector<HTMLElement>('.faq-icon')!;
        const isOpen = !answer.classList.contains('hidden');
        answer.classList.toggle('hidden', isOpen);
        icon.textContent = isOpen ? '+' : '−';
      });
    });
  </script>
</section>
