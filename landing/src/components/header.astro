---
import { Image } from 'astro:assets';
import favicon from '../assets/favicon.png';

const appUrl = 'https://app.quosel.com';

const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Live Example', href: '#showcase' },
  { label: 'Editor demo', href: '#editor-demo' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Pricing', href: '#pricing' },
];
---

<header class="bg-background/80 border-border sticky top-0 z-50 w-full border-b backdrop-blur-sm">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <Image src={favicon} alt="Quosel logo" width={32} height={32} class="h-8 w-8 rounded-lg" />
      <span class="text-card-foreground text-base font-semibold tracking-tight">Quosel</span>
    </a>

    <div class="text-muted-foreground hidden items-center gap-7 text-sm md:flex">
      {
        navLinks.map(({ label, href }) => (
          <a href={href} class="hover:text-foreground transition-colors">
            {label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href={appUrl}
        class="border-border bg-card text-foreground hover:bg-muted rounded-lg border px-4 py-2 text-sm font-medium transition-colors">
        Get started free
      </a>
    </div>
  </nav>
</header>
