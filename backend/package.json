{
  "name": "@quosel/backend",
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "========== Checks ==========": "",
    "tsc": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:inspect": "eslint --inspect-config",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "knip": "knip",
    "========== Database ==========": "",
    "db:types": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:lint": "squawk 'prisma/migrations/**/*.sql'",
    "========== Testing ==========": "",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "========== Other ==========": "",
    "openapi": "tsx scripts/generate-openapi.ts && openapi-typescript openapi.json -o ../frontend/src/api/schema.ts",
    "deploy": "railway redeploy --service quosel-backend --yes"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.38",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@hono/node-server": "^2.0.5",
    "@hono/zod-openapi": "^1.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@quosel/core": "workspace:*",
    "@sentry/node": "^10.58.0",
    "ai": "^6.0.205",
    "arctic": "^3.7.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "^6.12.4",
    "stripe": "^22.2.1",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@railway/cli": "^5.12.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "catalog:",
    "knip": "catalog:",
    "openapi-typescript": "^7.13.0",
    "prettier": "catalog:",
    "prisma": "^7.8.0",
    "squawk-cli": "^2.58.0",
    "ts-essentials": "^10.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  }
}
