{
  "name": "quosel-backend",
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "========== Checks ==========": "",
    "check-deps": "npm-check-updates -u",
    "tsc": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:inspect": "eslint --inspect-config",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "knip": "knip",
    "========== Database ==========": "",
    "db:types": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:lint": "squawk 'prisma/migrations/**/*.sql'",
    "========== Testing ==========": "",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "========== Other ==========": "",
    "openapi": "tsx scripts/generate-openapi.ts && openapi-typescript openapi.json -o ../frontend/src/api/schema.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@hono/zod-openapi": "^1.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "arctic": "^3.7.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "pg": "^8.21.0",
    "postgres": "^3.4.9",
    "stripe": "^22.1.1",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@railway/cli": "^4.62.0",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "knip": "^6.14.2",
    "npm-check-updates": "^22.2.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "squawk-cli": "^2.55.0",
    "ts-essentials": "^10.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
