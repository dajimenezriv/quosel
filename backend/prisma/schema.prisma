generator client {
  provider = "prisma-client"
  output   = "../src/infra/postgres/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid())
  googleId             String    @unique @map("google_id")
  email                String    @unique
  name                 String
  givenName            String    @map("given_name")
  familyName           String    @map("family_name")
  picture              String
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  subscriptionStatus   String    @default("") @map("subscription_status")
  subscriptionPriceId  String    @default("") @map("subscription_price_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  sessions      Session[]
  websites      Website[]
  websiteImages WebsiteImage[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Website {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String
  slug        String    @unique
  editToken   String    @unique @map("edit_token")
  context     String    @default("")
  blocks      Json
  styles      Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  websiteImages WebsiteImage[]

  @@index([userId])
  @@map("websites")
}

model WebsiteImage {
  id        String   @id
  userId    String   @map("user_id")
  websiteId String?  @map("website_id")
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([websiteId])
  @@map("website_images")
}
