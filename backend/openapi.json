{
  "openapi": "3.1.0",
  "info": {
    "title": "Quosel API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Place": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "displayName"
        ]
      },
      "PlacesError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/places": {
      "get": {
        "tags": [
          "Places"
        ],
        "summary": "Extract business info from a Google Maps URL",
        "description": "Accepts a Google Maps share link or full place URL. Resolves the URL, finds the place via Google Places API (New), and returns rich business data.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uri",
              "example": "https://maps.app.goo.gl/abc123"
            },
            "required": true,
            "name": "url",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Place details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Place"
                }
              }
            }
          },
          "400": {
            "description": "Could not parse URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacesError"
                }
              }
            }
          },
          "404": {
            "description": "Place not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacesError"
                }
              }
            }
          },
          "500": {
            "description": "Upstream API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacesError"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
