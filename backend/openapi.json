{
  "openapi": "3.1.0",
  "info": {
    "title": "Quosel API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "picture": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "subscriptionStatus": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "currentPeriodEnd": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "name",
                        "picture",
                        "subscriptionStatus",
                        "currentPeriodEnd"
                      ]
                    }
                  },
                  "required": [
                    "user"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/websites/get-websites": {
      "get": {
        "responses": {
          "200": {
            "description": "List of websites for the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "websites": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "userId": {
                            "type": "string"
                          },
                          "domain": {
                            "type": "string"
                          },
                          "template": {
                            "type": "string"
                          },
                          "texts": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "place": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "userId": {
                                "type": "string"
                              },
                              "googlePlaceId": {
                                "type": "string"
                              },
                              "displayNameText": {
                                "type": "string"
                              },
                              "displayNameLanguageCode": {
                                "type": "string"
                              },
                              "nationalPhoneNumber": {
                                "type": "string"
                              },
                              "internationalPhoneNumber": {
                                "type": "string"
                              },
                              "formattedAddress": {
                                "type": "string"
                              },
                              "shortFormattedAddress": {
                                "type": "string"
                              },
                              "latitude": {
                                "type": "number"
                              },
                              "longitude": {
                                "type": "number"
                              },
                              "rating": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "userRatingCount": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              },
                              "googleMapsPlaceUri": {
                                "type": "string"
                              },
                              "googleMapsReviewsUri": {
                                "type": "string"
                              },
                              "googleMapsPhotosUri": {
                                "type": "string"
                              },
                              "raw": {},
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "updatedAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "id",
                              "userId",
                              "googlePlaceId",
                              "displayNameText",
                              "displayNameLanguageCode",
                              "nationalPhoneNumber",
                              "internationalPhoneNumber",
                              "formattedAddress",
                              "shortFormattedAddress",
                              "latitude",
                              "longitude",
                              "rating",
                              "userRatingCount",
                              "googleMapsPlaceUri",
                              "googleMapsReviewsUri",
                              "googleMapsPhotosUri",
                              "createdAt",
                              "updatedAt"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "userId",
                          "domain",
                          "template",
                          "texts",
                          "createdAt",
                          "updatedAt",
                          "place"
                        ]
                      }
                    }
                  },
                  "required": [
                    "websites"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/websites/get-website/:websiteId": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "websiteId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Full website details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "userId": {
                      "type": "string"
                    },
                    "domain": {
                      "type": "string"
                    },
                    "template": {
                      "type": "string"
                    },
                    "texts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "place": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "userId": {
                          "type": "string"
                        },
                        "googlePlaceId": {
                          "type": "string"
                        },
                        "displayNameText": {
                          "type": "string"
                        },
                        "displayNameLanguageCode": {
                          "type": "string"
                        },
                        "nationalPhoneNumber": {
                          "type": "string"
                        },
                        "internationalPhoneNumber": {
                          "type": "string"
                        },
                        "formattedAddress": {
                          "type": "string"
                        },
                        "shortFormattedAddress": {
                          "type": "string"
                        },
                        "latitude": {
                          "type": "number"
                        },
                        "longitude": {
                          "type": "number"
                        },
                        "rating": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "userRatingCount": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "googleMapsPlaceUri": {
                          "type": "string"
                        },
                        "googleMapsReviewsUri": {
                          "type": "string"
                        },
                        "googleMapsPhotosUri": {
                          "type": "string"
                        },
                        "raw": {},
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "reviews": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "googleReviewName": {
                                "type": "string"
                              },
                              "rating": {
                                "type": "string"
                              },
                              "originalText": {
                                "type": "string"
                              },
                              "originalTextLanguageCode": {
                                "type": "string"
                              },
                              "authorDisplayName": {
                                "type": "string"
                              },
                              "authorPhotoUri": {
                                "type": "string"
                              },
                              "publishTime": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "googleMapsUri": {
                                "type": "string"
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "id",
                              "googleReviewName",
                              "rating",
                              "originalText",
                              "originalTextLanguageCode",
                              "authorDisplayName",
                              "authorPhotoUri",
                              "publishTime",
                              "googleMapsUri",
                              "createdAt"
                            ]
                          }
                        }
                      },
                      "required": [
                        "id",
                        "userId",
                        "googlePlaceId",
                        "displayNameText",
                        "displayNameLanguageCode",
                        "nationalPhoneNumber",
                        "internationalPhoneNumber",
                        "formattedAddress",
                        "shortFormattedAddress",
                        "latitude",
                        "longitude",
                        "rating",
                        "userRatingCount",
                        "googleMapsPlaceUri",
                        "googleMapsReviewsUri",
                        "googleMapsPhotosUri",
                        "createdAt",
                        "updatedAt",
                        "reviews"
                      ]
                    },
                    "images": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "sizeBytes": {
                            "type": "number"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "id",
                          "url",
                          "sizeBytes",
                          "createdAt"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "userId",
                    "domain",
                    "template",
                    "texts",
                    "createdAt",
                    "updatedAt",
                    "place",
                    "images"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Website not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/websites/create-from-google-place": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ChIJRWnYS1BHYA0RK5rHEosqXcQ"
            },
            "required": true,
            "name": "googlePlaceId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Website id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "websiteId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "websiteId"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
