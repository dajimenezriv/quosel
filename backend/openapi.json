        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/websites/get-websites": {
      "get": {
        "responses": {
          "200": {
            "description": "List of websites for the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebsitesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/websites/get-website/:websiteId": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "websiteId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Full website details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebsiteResponse"
                }
              }
            }
          },
          "404": {
            "description": "Website not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/websites/create-from-google-place": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ChIJRWnYS1BHYA0RK5rHEosqXcQ"
            },
            "required": true,
            "name": "googlePlaceId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Place details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Website"
                }
              }
            }
          },
          "500": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
